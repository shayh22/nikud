{
  "_doc": "כללי הומוגרפים שנכתבו ביד. גוברים על הלקסיקון ועל המודל. מחרוזת = הכרעה קבועה; אובייקט = הכרעה לפי הקשר, עם default / after (המילה הקודמת) / before (המילה הבאה). המפתחות הם שלד עיצורים ללא ניקוד.",
  "שם": {
    "default": "שֵׁם",
    "before": { "שמים": "שֵׁם", "הויה": "שֵׁם" },
    "after": { "ב": "שָׁם", "מ": "מִשָּׁם" }
  },
  "ברא": { "default": "בָּרָא", "after": { "בראשית": "בָּרָא" } },
  "ספר": { "default": "סֵפֶר", "after": { "אמר": "סָפַר", "ו": "סִפֵּר" } },
  "דבר": { "default": "דָּבָר", "after": { "ו": "דִּבֵּר" } },
  "רבי": { "default": "רַבִּי" },
  "רבו": { "default": "רַבּוֹ" },
  "אמר": { "default": "אָמַר", "after": { "ו": "וַיֹּאמֶר" } },
  "אמרו": { "default": "אָמְרוּ" },
  "חכמים": { "default": "חֲכָמִים" },
  "תורה": { "default": "תּוֹרָה" },
  "מצוה": { "default": "מִצְוָה" },
  "מצות": { "default": "מִצְוֹת" },
  "ישראל": { "default": "יִשְׂרָאֵל" },
  "שבת": { "default": "שַׁבָּת", "after": { "ו": "וְשָׁבַת" } }
}
